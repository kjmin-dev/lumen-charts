{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"paths": {
			"@lumen-ticks/core": ["../../packages/core/src/index.ts"],
			"@lumen-ticks/engine": ["../../packages/engine/src/index.ts"]
		}
	},
	"include": ["scripts", "src/**/*.ts", "test"],
	"exclude": ["src/pages", "src/content.config.ts"]
}
