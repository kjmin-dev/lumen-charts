{
	"name": "lumen-charts-monorepo",
	"private": true,
	"description": "High-performance financial charting engine for the web.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjmin-dev/lumen-charts.git"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" run build",
		"clean": "pnpm -r --filter \"./packages/*\" run clean",
		"typecheck": "tsrs -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"dev": "pnpm --filter @lumen-charts/example-vanilla dev",
		"bench": "pnpm --filter @lumen-charts/benchmarks bench",
		"bench:install": "pnpm --filter @lumen-charts/benchmarks exec playwright install chromium",
		"bench:dev": "pnpm --filter @lumen-charts/benchmarks dev",
		"bench:serve": "pnpm --filter @lumen-charts/benchmarks serve",
		"bench:report": "pnpm --filter @lumen-charts/benchmarks report",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"happy-dom": "^21.0.4",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"solid-js": "^1.9.19",
		"svelte": "^5.57.3",
		"tsrs": "0.25.0-ts7.1.0-beta",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vue": "^3.5.45"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.20.0"
}
