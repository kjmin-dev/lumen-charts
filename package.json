{
	"name": "lumen-ticks-monorepo",
	"private": true,
	"description": "High-performance financial charting engine for the web.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjmin-dev/lumen-ticks.git"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" run build",
		"clean": "pnpm -r --filter \"./packages/*\" run clean",
		"typecheck": "tsrs -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"dev": "pnpm --filter @lumen-ticks/example-vanilla dev",
		"docs:dev": "pnpm --filter @lumen-ticks/docs dev",
		"docs:build": "pnpm --filter @lumen-ticks/docs build",
		"docs:preview": "pnpm --filter @lumen-ticks/docs preview",
		"docs:typecheck": "pnpm --filter @lumen-ticks/docs typecheck",
		"docs:test": "pnpm --filter @lumen-ticks/docs test",
		"deploy:docs": "pnpm --filter @lumen-ticks/deploy exec wrangler deploy --cwd ../../apps/docs",
		"bench": "pnpm --filter @lumen-ticks/benchmarks bench",
		"bench:install": "pnpm --filter @lumen-ticks/benchmarks exec playwright install chromium",
		"bench:dev": "pnpm --filter @lumen-ticks/benchmarks dev",
		"bench:serve": "pnpm --filter @lumen-ticks/benchmarks serve",
		"bench:report": "pnpm --filter @lumen-ticks/benchmarks report",
		"bench:profile": "pnpm --filter @lumen-ticks/benchmarks run profile",
		"bench:merge": "pnpm --filter @lumen-ticks/benchmarks merge",
		"bench:tidy": "pnpm --filter @lumen-ticks/benchmarks tidy",
		"bench:pixels": "pnpm --filter @lumen-ticks/benchmarks pixels",
		"changeset": "changeset",
		"version-packages": "changeset version && oxfmt",
		"release:check": "node scripts/release.ts check",
		"release:plan": "node scripts/release.ts plan",
		"release:publish": "node scripts/release.ts publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"happy-dom": "^21.0.4",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"solid-js": "^1.9.19",
		"svelte": "^5.57.3",
		"tsrs": "0.25.0-ts7.1.0-beta",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vue": "^3.5.45"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.20.0"
}
