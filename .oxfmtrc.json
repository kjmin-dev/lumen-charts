{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "avoid",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"astro": true,
	"ignorePatterns": [
		"apps/docs/.astro/**",
		"apps/docs/dist/**",
		"apps/docs/src/content/docs/guides/**",
		"apps/docs/src/content/docs/reference/**",
		"apps/docs/src/content/docs/releasing.md"
	]
}
