+
+// First assign each point to its center column once. Eight extra rows cover
+// a square that crosses a 1024-row workgroup boundary at size nine.
+export const centerShader = (format: MarkTextureFormat) => common(format) + `
+@group(0) @binding(7) var<storage,read_write> centers:array<u32>;
+var<workgroup> winners:array<atomic<u32>,1032>;
+@compute @workgroup_size(64)
+fn main(@builtin(workgroup_id) g:vec3u,@builtin(local_invocation_index) lane:u32) {
+	let x=g.x; let top=g.y*1024u; let h=min(v.height-top,1024u);
+	for(var id=spans[x]+lane;id<spans[x+1u];id+=64u){
+		let y=bitcast<i32>(data[id*2u])-i32(v.size/2u)-i32(top)+i32(v.size)-1;
+		if(y>=0 && y<i32(h+v.size-1u)){atomicMax(&winners[u32(y)],id+1u);}
+	}
+	workgroupBarrier();
+	for(var y=lane;y<h;y+=64u){
+		var winner=0u;
+		for(var dy=0u;dy<v.size;dy++){winner=max(winner,atomicLoad(&winners[y+dy]));}
+		centers[x*v.height+top+y]=winner;
+	}
+}`;
+
+export const resolveShader = (format: MarkTextureFormat) => common(format) + `
+@group(0) @binding(7) var<storage,read> centers:array<u32>;
+@compute @workgroup_size(8,8)
+fn main(@builtin(global_invocation_id) gid:vec3u) {
+	let x=gid.x;let y=gid.y;
+	if(x>=v.width || y>=v.height){return;}
+	var winner=0u;
+	for(var dx=0u;dx<v.size;dx++){winner=max(winner,centers[(x+dx)*v.height+y]);}
+	var c=vec4f(0);
+	if(winner!=0u){c=color(data[2u*(winner-1u)+1u]);}
+	textureStore(image,vec2u(x,y),c);
+}`;
