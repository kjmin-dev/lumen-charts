{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@lumen-ticks/core": ["./packages/core/src/index.ts"],
			"@lumen-ticks/core/worker": ["./packages/core/src/worker.ts"],
			"@lumen-ticks/engine": ["./packages/engine/src/index.ts"],
			"@lumen-ticks/engine/worker": ["./packages/engine/src/worker.ts"],
			"@lumen-ticks/react": ["./packages/react/src/index.ts"],
			"@lumen-ticks/react/worker": ["./packages/react/src/worker.ts"],
			"@lumen-ticks/vue": ["./packages/vue/src/index.ts"],
			"@lumen-ticks/vue/worker": ["./packages/vue/src/worker.ts"],
			"@lumen-ticks/svelte": ["./packages/svelte/src/index.ts"],
			"@lumen-ticks/svelte/worker": ["./packages/svelte/src/worker.ts"],
			"@lumen-ticks/solid": ["./packages/solid/src/index.ts"],
			"@lumen-ticks/solid/worker": ["./packages/solid/src/worker.ts"]
		}
	},
	"include": [
		"./packages/*/src",
		"packages/*/test",
		"examples/*/src",
		"benchmarks/src",
		"benchmarks/runner",
		"benchmarks/test",
		"benchmarks/vite.config.ts",
		"vitest.config.ts",
		"scripts"
	]
}
